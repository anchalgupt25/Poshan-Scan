# NouriScan is a personal project and must not route through the Walmart
# corporate proxy configured in ~/.npmrc (sysproxy.wal-mart.com), which is only
# reachable on the corp network. `noproxy` bypasses it for this directory only;
# the global work config is left untouched.
noproxy=registry.npmjs.org,npmjs.org,nodejs.org
registry=https://registry.npmjs.org/
fund=false
audit=false
