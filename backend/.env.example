# Nouri Scan backend — copy to .env and fill in real values
# cp .env.example .env

# ─── External APIs ───────────────────────────────────────────────────────────

# USDA FoodData Central API Key
# Free key: https://fdc.nal.usda.gov/api-guide.html#bkmk-1  (1,000 req/hour)
# DEMO_KEY works but is rate-limited to 30 req/min
USDA_FDC_API_KEY=DEMO_KEY

# Anthropic Claude API (Nouri Bot + photo OCR)
# Sign up: https://console.anthropic.com
# Leave blank to use the rule-based bot only (no photo OCR).
ANTHROPIC_API_KEY=

# Walmart Element LLM Gateway (optional — only if you have access)
# Used in preference to direct Anthropic when set.
ELEMENT_LLM_API_KEY=
ELEMENT_LLM_API_URL=https://api.element.walmart.com/v1/chat/completions
ELEMENT_LLM_MODEL=gpt-4o-mini

# Open Food Facts — no key needed (3M+ products, free, public)
# If behind a proxy:
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# ─── Email OTP auth ──────────────────────────────────────────────────────────

# Resend — for OTP email delivery. Free tier: 100/day, no card needed.
# Sign up: https://resend.com → Settings → API Keys → Create
# Leave EMPTY for dev mode (OTPs print to backend console).
RESEND_API_KEY=

# Sender address. Resend offers a sandbox sender `onboarding@resend.dev`
# without domain setup. For production, verify your domain in Resend first.
RESEND_FROM=Nouri Scan <onboarding@resend.dev>

# Comma-separated invite codes. Share with beta testers. Case-insensitive.
INVITE_CODES=NOURI-FAMILY,NOURI-BETA

# Auth session signing secret. Generate a strong one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=please-generate-a-strong-secret

# Session length in days
AUTH_SESSION_DAYS=30

# OTP TTL in minutes
OTP_TTL_MINUTES=10
# Max OTP requests per email per hour (rate limit)
OTP_MAX_PER_HOUR=5

# ─── Server ──────────────────────────────────────────────────────────────────

# CORS — Vite dev server port
FRONTEND_URL=http://localhost:5173
