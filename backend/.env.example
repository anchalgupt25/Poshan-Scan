# Poshan Scan Backend — copy to .env and fill in values
# cp .env.example .env

# ---------------------------------------------------------------------------
# USDA FoodData Central API Key
# ---------------------------------------------------------------------------
# Free key at: https://fdc.nal.usda.gov/api-guide.html#bkmk-1
# DEMO_KEY = 30 req/min (limited). With key = 1,000 req/hour.
# Covers: ~1M US branded foods with UPC barcodes (FDA/USDA regulated)
USDA_FDC_API_KEY=DEMO_KEY

# ---------------------------------------------------------------------------
# Open Food Facts — No key needed! 3M+ global products.
# ---------------------------------------------------------------------------
# If behind a proxy (e.g. corp network), set these:
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# ---------------------------------------------------------------------------
# Element LLM Gateway (Walmart internal) — for Claude AI narration
# ---------------------------------------------------------------------------
# Get key via: https://wmlink.wal-mart.com/genai-access
# Leave blank to use rule-based verdict text (fully functional without it)
LLM_GATEWAY_KEY=
LLM_GATEWAY_URL=

# ---------------------------------------------------------------------------
# App settings
# ---------------------------------------------------------------------------
# CORS — frontend dev URL
FRONTEND_URL=http://localhost:5173

# Set to 1 to bypass real APIs and always use demo products (offline dev mode)
# POSHAN_DEMO_MODE=1
